{
  "name": "quickwallet-monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "yarn workspace quickwallet-backend dev",
    "dev:frontend": "yarn workspace quickwallet start",
    "android": "yarn workspace quickwallet android",
    "ios": "yarn workspace quickwallet ios",
    "build:backend": "yarn workspace quickwallet-backend build",
    "typecheck:backend": "yarn workspace quickwallet-backend typecheck",
    "typecheck:frontend": "yarn workspace quickwallet typecheck",
    "typecheck": "yarn typecheck:backend && yarn typecheck:frontend",
    "test:backend": "yarn workspace quickwallet-backend test",
    "test:frontend": "yarn workspace quickwallet test",
    "test": "yarn test:backend && yarn test:frontend",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{js,ts,json,md}": [
      "prettier --write"
    ]
  }
}
